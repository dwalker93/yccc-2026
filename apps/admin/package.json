{
  "name": "admin",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "auth:schema:gen": "bun x auth@latest generate --config ./src/lib/auth/auth.ts --output ./src/lib/db/schemas/auth-schema.ts",
    "auth:db:gen": "drizzle-kit generate --config ./drizzle.auth.config.ts",
    "auth:db:push": "drizzle-kit push --config ./drizzle.auth.config.ts",
    "auth:db:studio": "drizzle-kit studio --config ./drizzle.auth.config.ts",
    "app:db:gen": "drizzle-kit generate --config ./drizzle.app.config.ts",
    "app:db:push": "drizzle-kit push --config ./drizzle.app.config.ts",
    "app:db:studio": "drizzle-kit studio --config ./drizzle.app.config.ts",
    "app:db:seed": "bun src/migrations/seed.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@getbrevo/brevo": "^6.0.3",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.9",
    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.3",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/webpack": "^4.3.3",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.101.4",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3"
  }
}
